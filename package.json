{
  "name": "donaldpi",
  "version": "0.0.4",
  "description": "Donald Mok's Pi agent setup",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsup",
    "gh": "simple-git-hooks"
  },
  "author": "donaldxdonald",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "devDependencies": {
    "@dndxdnd/eslint-config": "^2.11.2",
    "bumpp": "^12.2.2",
    "eslint": "^9.39.5",
    "lint-staged": "^17.1.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@narumitw/pi-goal": "^0.54.4",
    "@router-for-me/pi-cliproxyapi-provider": "^1.4.15",
    "@tintinweb/pi-subagents": "^0.19.0",
    "pi-mcp-adapter": "^2.32.1",
    "pi-web-access": "^0.27.0"
  },
  "bundleDependencies": [
    "@narumitw/pi-goal",
    "@router-for-me/pi-cliproxyapi-provider",
    "@tintinweb/pi-subagents",
    "pi-mcp-adapter",
    "pi-web-access"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "node_modules/@narumitw/pi-goal/src/index.ts",
      "node_modules/@router-for-me/pi-cliproxyapi-provider/extensions/index.ts",
      "node_modules/@tintinweb/pi-subagents/src/index.ts",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/pi-web-access/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
