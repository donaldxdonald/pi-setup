{
  "name": "donaldpi",
  "version": "0.2.0",
  "description": "Donald Mok's Pi agent setup",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsup",
    "bump": "bumpp",
    "gh": "simple-git-hooks"
  },
  "author": "donaldxdonald",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "devDependencies": {
    "@dndxdnd/eslint-config": "^2.11.2",
    "bumpp": "^12.3.0",
    "eslint": "^9.39.5",
    "lint-staged": "^17.1.0",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@tintinweb/pi-subagents": "^0.25.0",
    "pi-web-access": "^0.47.0"
  },
  "bundleDependencies": [
    "@tintinweb/pi-subagents",
    "pi-web-access"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "node_modules/@tintinweb/pi-subagents/src/index.ts",
      "node_modules/pi-web-access/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
